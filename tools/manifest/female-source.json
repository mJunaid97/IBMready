{
 "_about": "Source mapping for the layers that tools/build-female-atlas.mjs appends to data/hd/atlas.json and data/lite/atlas.json: the female body (NIH Human Reference Atlas, Visible Human Female) fitted into the BodyParts3D male reference frame, and a schematic gender-affirming-surgery layer generated procedurally in that frame. The male systems, pieces and GLBs are never touched. Concept ids are UBERON/FMA where the source gives them; HRA:* and GA:* ids are grouping concepts of this project, not ontology terms. Schematic coordinates are millimetres in the atlas frame (y up, +x subject's left, +z anterior).",
 "source": {
  "name": "Human Reference Atlas (HRA) 3D Reference Organ Library, united female v1.5",
  "attribution": "3D Reference Organ Library, Human Reference Atlas (HRA), HuBMAP Consortium / NIH, licensed under CC BY 4.0; meshes derived from the Visible Human Female dataset of the U.S. National Library of Medicine",
  "credit": "NIH Human Reference Atlas / Visible Human Female (NLM)",
  "url": "https://humanatlas.io/",
  "license": "CC-BY-4.0",
  "licenseUrl": "https://creativecommons.org/licenses/by/4.0/",
  "sourceFile": "https://cdn.humanatlas.io/digital-objects/ref-organ/united-female/v1.5/assets/3d-vh-f-united.glb",
  "redistribution": {
   "name": "Anatria-3D (Draco-compressed per-system GLBs of the HRA united-female model with manifest_female.json)",
   "url": "https://github.com/Nurkan1/Anatria-3D",
   "path": "public/anatomy/*_female.glb"
  },
  "frame": "metres, y up, +x subject's left, +z anterior (the same orientation as the atlas; origin near the pelvis)"
 },
 "files": {
  "reproductive": "reproductive_female.glb",
  "integumentary": "integumentary_female.glb",
  "skeletal": "skeletal_female.glb",
  "renal": "renal_female.glb"
 },
 "fit": {
  "_about": "How the female meshes are placed in the male frame. Pelvis: one uniform scale (the mean of the hip-width ratio and the symphysis-to-promontory ratio), x centred on the hip bones, y and z pinned at the top of the pubic symphysis; the sacral promontory is reported as the check. Thorax: the same scale, nipples centred on the midline at nippleY, the breast base set breastEmbed mm under the chest skin at the nipple column, each breast then scaled by breastScale about that base point (the Visible Human Female was a large woman; 0.8 sits her breasts on the reference torso at a typical size) and shrink-wrapped onto the male chest wall with a depth-weighted warp so the base follows the chest and the front keeps its shape.",
  "pelvis": {
   "hipLeft": "VH_F_ilium_compact_bone_L",
   "hipRight": "VH_F_ilium_compact_bone_R",
   "pubis": [
    "VH_F_pubis_compact_bone_L",
    "VH_F_pubis_compact_bone_R"
   ],
   "sacrum": "VH_F_sacrum",
   "male": {
    "hipLeft": "Left hip bone",
    "hipRight": "Right hip bone",
    "sacrum": "Sacrum"
   }
  },
  "thorax": {
   "nippleY": 1175,
   "breastEmbed": 4,
   "breastScale": 0.8,
   "fat": [
    "VH_F_fat_L",
    "VH_F_fat_R"
   ],
   "nipple": [
    "VH_F_nipple_L",
    "VH_F_nipple_R"
   ],
   "warpCell": 10,
   "warpSmooth": 15
  }
 },
