{"_about": "Brand and combination products mapped to their active ingredients. The interaction checker resolves a brand to its ingredients and checks each one, and flags a product that duplicates an ingredient already entered. Product availability, names and strengths differ by country.","_updated": "2026-09-12","products": {"co-codamol": {"name": "Co-codamol","aliases": ["Solpadeine Max","Kapake","Zapain","Codipar"],"ingredients": ["paracetamol",{"name": "Codeine"}],"jurisdictions": ["UK"],"note": "Paracetamol with codeine; 8/500 strength available from UK pharmacies, higher strengths on prescription. Counts towards the daily paracetamol total.","source": {"title": "NHS: Co-codamol for adults","url": "https://www.nhs.uk/medicines/co-codamol-for-adults/","jurisdiction": "UK","type": "regulatory"},"kind": "combination"},"co-amoxiclav": {"name": "Co-amoxiclav","aliases": ["Augmentin"],"ingredients": ["amoxicillin",{"name": "Clavulanic acid"}],"jurisdictions": ["UK","US","EU"],"note": "Amoxicillin with the beta-lactamase inhibitor clavulanic acid; carries amoxicillin's allergy profile plus a risk of cholestatic jaundice.","source": {"title": "NHS: Co-amoxiclav","url": "https://www.nhs.uk/medicines/co-amoxiclav/","jurisdiction": "UK","type": "regulatory"},"kind": "combination"},"nurofen-plus": {"name": "Nurofen Plus","aliases": ["ibuprofen and codeine"],"ingredients": ["ibuprofen",{"name": "Codeine"}],"jurisdictions": ["UK"],"note": "Ibuprofen with codeine, pharmacy-only in the UK for short-term use.","source": {"title": "NHS: Ibuprofen for adults","url": "https://www.nhs.uk/medicines/ibuprofen-for-adults/","jurisdiction": "UK","type": "regulatory"},"kind": "combination"},"anadin-extra": {"name": "Anadin Extra","aliases": ["aspirin, paracetamol and caffeine"],"ingredients": ["aspirin","paracetamol",{"name": "Caffeine"}],"jurisdictions": ["UK"],"note": "A combination painkiller containing both aspirin and paracetamol; counts towards both totals.","source": {"title": "NHS: Paracetamol for adults","url": "https://www.nhs.uk/medicines/paracetamol-for-adults/","jurisdiction": "UK","type": "regulatory"},"kind": "combination"},"lemsip-max": {"name": "Lemsip Max","aliases": ["cold and flu remedies with paracetamol","Beechams Flu Plus","Day Nurse"],"ingredients": ["paracetamol",{"name": "Phenylephrine"}],"jurisdictions": ["UK"],"note": "One of many cold and flu remedies containing paracetamol; the commonest source of accidental paracetamol duplication.","source": {"title": "NHS: Paracetamol for adults","url": "https://www.nhs.uk/medicines/paracetamol-for-adults/","jurisdiction": "UK","type": "regulatory"},"kind": "combination"},"tylenol-pm": {"name": "Tylenol PM","aliases": ["acetaminophen and diphenhydramine"],"ingredients": ["paracetamol",{"name": "Diphenhydramine"}],"jurisdictions": ["US"],"note": "Acetaminophen (paracetamol) with the sedating antihistamine diphenhydramine.","source": {"title": "MedlinePlus: Acetaminophen","url": "https://medlineplus.gov/druginfo/meds/a681004.html","jurisdiction": "US","type": "regulatory"},"kind": "combination"},"excedrin": {"name": "Excedrin","aliases": ["acetaminophen, aspirin and caffeine"],"ingredients": ["paracetamol","aspirin",{"name": "Caffeine"}],"jurisdictions": ["US"],"note": "Contains both acetaminophen and aspirin.","source": {"title": "MedlinePlus: Aspirin","url": "https://medlineplus.gov/druginfo/meds/a682878.html","jurisdiction": "US","type": "regulatory"},"kind": "combination"},"exforge": {"name": "Exforge","aliases": ["amlodipine and valsartan"],"ingredients": ["amlodipine",{"name": "Valsartan","drugClass": "angiotensin-receptor-blockers"}],"jurisdictions": ["UK","US","EU"],"note": "Amlodipine with the ARB valsartan; carries the interactions of both.","source": {"title": "BNF: Amlodipine","url": "https://bnf.nice.org.uk/drugs/amlodipine/","section": "Indications and dose","jurisdiction": "UK","type": "guidance"},"kind": "combination"},"caduet": {"name": "Caduet","aliases": ["amlodipine and atorvastatin"],"ingredients": ["amlodipine","atorvastatin"],"jurisdictions": ["US"],"note": "Amlodipine with atorvastatin in one tablet.","source": {"title": "MedlinePlus: Amlodipine","url": "https://medlineplus.gov/druginfo/meds/a692044.html","jurisdiction": "US","type": "regulatory"},"kind": "combination"},"cozaar-comp": {"name": "Cozaar-Comp","aliases": ["Hyzaar","losartan and hydrochlorothiazide"],"ingredients": ["losartan",{"name": "Hydrochlorothiazide"}],"jurisdictions": ["UK","US","EU"],"note": "Losartan with a thiazide diuretic; adds low potassium and sodium and gout to losartan's own cautions.","source": {"title": "BNF: Losartan potassium","url": "https://bnf.nice.org.uk/drugs/losartan-potassium/","section": "Indications and dose","jurisdiction": "UK","type": "guidance"},"kind": "combination"},"zestoretic": {"name": "Zestoretic","aliases": ["lisinopril and hydrochlorothiazide","Prinzide"],"ingredients": ["lisinopril",{"name": "Hydrochlorothiazide"}],"jurisdictions": ["UK","US"],"note": "Lisinopril with a thiazide diuretic.","source": {"title": "BNF: Lisinopril","url": "https://bnf.nice.org.uk/drugs/lisinopril/","section": "Indications and dose","jurisdiction": "UK","type": "guidance"},"kind": "combination"},"janumet": {"name": "Janumet","aliases": ["sitagliptin and metformin"],"ingredients": ["metformin",{"name": "Sitagliptin"}],"jurisdictions": ["UK","US","EU"],"note": "Metformin with the DPP-4 inhibitor sitagliptin; all metformin cautions apply.","source": {"title": "BNF: Metformin hydrochloride","url": "https://bnf.nice.org.uk/drugs/metformin-hydrochloride/","section": "Indications and dose","jurisdiction": "UK","type": "guidance"},"kind": "combination"},"entresto": {"name": "Entresto","aliases": ["sacubitril and valsartan","sacubitril/valsartan"],"ingredients": [{"name": "Sacubitril"},{"name": "Valsartan","drugClass": "angiotensin-receptor-blockers"}],"jurisdictions": ["UK","US","EU"],"note": "A heart-failure medicine that must never be combined with an ACE inhibitor (36-hour washout) because of angioedema.","source": {"title": "BNF: Lisinopril","url": "https://bnf.nice.org.uk/drugs/lisinopril/","section": "Contra-indications","jurisdiction": "UK","type": "guidance"},"kind": "combination"},"zegerid": {"name": "Zegerid","aliases": ["omeprazole and sodium bicarbonate"],"ingredients": ["omeprazole",{"name": "Sodium bicarbonate"}],"jurisdictions": ["US"],"note": "Immediate-release omeprazole buffered with sodium bicarbonate.","source": {"title": "MedlinePlus: Omeprazole","url": "https://medlineplus.gov/druginfo/meds/a693050.html","jurisdiction": "US","type": "regulatory"},"kind": "combination"}}}
