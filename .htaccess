  RewriteRule ^tests/categories/(allergy\-tests)/?$ /tests/categories/allergy/ [R=301,L]
  RewriteRule ^tests/categories/(autoantibodies|autoimmune|rheumatology)/?$ /tests/categories/autoimmune-rheumatology/ [R=301,L]
  RewriteRule ^tests/categories/(blood\-bank|blood\-group|transfusion)/?$ /tests/categories/blood-bank-transfusion/ [R=301,L]
  RewriteRule ^tests/categories/(blood\-hematology|haematology|hematology)/?$ /tests/categories/blood-haematology/ [R=301,L]
  RewriteRule ^tests/categories/(body\-fluids|csf\-tests|fluid\-analysis)/?$ /tests/categories/body-fluid-analysis/ [R=301,L]
  RewriteRule ^tests/categories/(bone\-tests|joint\-tests|musculoskeletal|orthopaedic\-tests)/?$ /tests/categories/bone-joint-musculoskeletal/ [R=301,L]
  RewriteRule ^tests/categories/(cancer\-tests|cancer\-tumor\-markers|tumor\-markers|tumour\-markers)/?$ /tests/categories/cancer-tumour-markers/ [R=301,L]
  RewriteRule ^tests/categories/(cardiac|cardiology|heart\-tests)/?$ /tests/categories/cardiovascular/ [R=301,L]
  RewriteRule ^tests/categories/(chemistry|clinical\-chemistry|metabolic)/?$ /tests/categories/chemistry-metabolic/ [R=301,L]
  RewriteRule ^tests/categories/(clotting\-tests|coagulation|coagulation\-hemostasis)/?$ /tests/categories/coagulation-haemostasis/ [R=301,L]
