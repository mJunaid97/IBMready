  RewriteRule ^tests/categories/(diagnostic\-procedures|endoscopy|scope\-tests)/?$ /tests/categories/endoscopy-diagnostic-procedures/ [R=301,L]
  RewriteRule ^tests/categories/(eye\-tests|ophthalmology|vision\-tests)/?$ /tests/categories/eye-ophthalmic/ [R=301,L]
  RewriteRule ^tests/categories/(digestive\-tests|gi\-tests|gut\-tests)/?$ /tests/categories/gastroenterology/ [R=301,L]
  RewriteRule ^tests/categories/(dna\-tests|genetic|genetics|molecular)/?$ /tests/categories/genetic-molecular/ [R=301,L]
  RewriteRule ^tests/categories/(audiology|balance\-tests|hearing\-tests|vestibular)/?$ /tests/categories/hearing-balance/ [R=301,L]
  RewriteRule ^tests/categories/(imaging\-studies|radiology|scans)/?$ /tests/categories/imaging/ [R=301,L]
  RewriteRule ^tests/categories/(immunology|inflammation|inflammatory\-markers)/?$ /tests/categories/immunology-inflammation/ [R=301,L]
  RewriteRule ^tests/categories/(infection\-tests|infectious\-disease|microbiology)/?$ /tests/categories/infectious-disease-microbiology/ [R=301,L]
  RewriteRule ^tests/categories/(kidney|renal|urinary|urine\-tests)/?$ /tests/categories/kidney-urinary/ [R=301,L]
  RewriteRule ^tests/categories/(kidney\-tests|urology|urology\-tests)/?$ /tests/categories/kidney-urology-diagnostics/ [R=301,L]
  RewriteRule ^tests/categories/(cardiometabolic|cholesterol\-tests|lipids)/?$ /tests/categories/lipid-cardiometabolic/ [R=301,L]
  RewriteRule ^tests/categories/(hepatic|hepatobiliary|liver)/?$ /tests/categories/liver-hepatobiliary/ [R=301,L]
  RewriteRule ^tests/categories/(brain\-tests|nerve\-tests|neurological)/?$ /tests/categories/neurology/ [R=301,L]
  RewriteRule ^tests/categories/(biopsy\-tests|cytology|histopathology|pathology)/?$ /tests/categories/pathology-cytology/ [R=301,L]
  RewriteRule ^tests/categories/(home\-tests|point\-of\-care|self\-tests)/?$ /tests/categories/point-of-care-home-testing/ [R=301,L]
  RewriteRule ^tests/categories/(antenatal|pregnancy|prenatal)/?$ /tests/categories/pregnancy-prenatal/ [R=301,L]
  RewriteRule ^tests/categories/(fertility|reproductive)/?$ /tests/categories/reproductive-fertility/ [R=301,L]
  RewriteRule ^tests/categories/(breathing\-tests|lung\-tests|pulmonary)/?$ /tests/categories/respiratory/ [R=301,L]
  RewriteRule ^tests/categories/(assessment\-tools|clinical\-scores|risk\-scores|screening\-tools)/?$ /tests/categories/screening-clinical-assessment/ [R=301,L]
  RewriteRule ^tests/categories/(sleep\-studies|sleep\-tests)/?$ /tests/categories/sleep/ [R=301,L]
  RewriteRule ^tests/categories/(drug\-levels|tdm|therapeutic\-drug\-monitoring|toxicology)/?$ /tests/categories/toxicology-drug-monitoring/ [R=301,L]
  RewriteRule ^tests/categories/(measurements|observations|vital\-signs)/?$ /tests/categories/vital-signs-physiological-measurements/ [R=301,L]
  RewriteRule ^tests/categories/(iron\-tests|minerals|nutrition|vitamins)/?$ /tests/categories/vitamins-minerals-nutrition/ [R=301,L]
  # /medications/classes/<class>/ is the recommended address of a class page; /drug-classes/<class>/ is canonical
  RewriteRule ^medications/classes/([A-Za-z0-9-]+)/?$ /drug-classes/$1/ [R=301,L]
  RewriteRule ^tests/categories/([A-Za-z0-9-]+)$ /tests/categories/$1/ [R=301,L]
  # organ pages moved to /anatomy/
  RewriteRule ^organs/([A-Za-z0-9-]+)/?$ /anatomy/$1/ [R=301,L]
  # trailing slash on every section page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(anatomy|systems|physiology|symptoms|conditions|tests|biomarkers|imaging|procedures|medications|drug-classes|targets|first-aid|health|compare)/([A-Za-z0-9-]+)$ /$1/$2/ [R=301,L]

  # ---- unknown clean URLs fall through to the real 404 page: every entity page is a prerendered directory
</IfModule>

# ---- custom error page (a real 404 status, never a 200 "not found" page)
ErrorDocument 404 /404.html

# ---- correct media types (the explorer checks the glTF magic bytes but browsers still prefer the right type)
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/json .json
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType application/wasm .wasm
  AddType application/xml .xml
  AddType font/woff2 .woff2
  AddType image/x-icon .ico
  AddCharset utf-8 .html .css .js .mjs .json .svg .md .txt .webmanifest .xml
</IfModule>

# ---- compression (JSON and JS shrink 4-6x; GLB is already meshopt-compressed but still gains ~10%)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/markdown application/javascript application/json application/manifest+json image/svg+xml model/gltf-binary application/xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/markdown application/javascript application/json application/manifest+json image/svg+xml model/gltf-binary application/xml
</IfModule>

# ---- caching: fingerprint-free but versioned by deploy; geometry, previews and vendor code change rarely
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 365 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(glb|jpg|png|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.xml$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # ---- the embedded explorer view (?embed=1) is the same page inside an iframe, never a separate indexable
  # URL. explorer/app.js sets noindex in the browser, but a crawler reads the prerendered HTML and never runs
  # it, so the directive has to come from the server. robots.txt deliberately does not block this view: a
  # blocked URL can never be read for its noindex, and the facade iframe must stay fetchable.
  SetEnvIf Query_String "(^|&)embed=1(&|$)" EMBED_VIEW
  Header always set X-Robots-Tag "noindex, follow" env=EMBED_VIEW

  # ---- security headers (the pages also carry a meta CSP; frame-ancestors can only be set here)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-0ZYYoMVH8skVI3zJ7AfEL0FDpRE4dS3zbGhdQKihick=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self'; frame-ancestors 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header unset X-Powered-By
</IfModule>

# ---- never serve repository housekeeping
<FilesMatch "^(\.git.*|\.env.*|\.htpasswd|package(-lock)?\.json|.*\.py|.*\.yml|.*\.yaml)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
