# Anatomy Nexus — Apache / LiteSpeed configuration (Hostinger shared hosting and similar).
# tools/package-site.py copies this file into dist/ and fills in the generated URL rules (alias redirects,
# query-URL redirects, trailing slashes) at the marker below. The site also works with no server
# configuration at all; these rules add HTTPS, one canonical URL per page, media types, caching and headers.

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- HTTPS and one canonical host, in one hop (Hostinger terminates TLS on a proxy: check the forwarded header too)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ---- one canonical URL per page (generated by tools/package-site.py)
  # query-style detail URLs -> clean URLs
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^anatomy/organ\.html$ /anatomy/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^systems/system\.html$ /systems/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^physiology/topic\.html$ /physiology/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^symptoms/symptom\.html$ /symptoms/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^conditions/condition\.html$ /conditions/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^tests/test\.html$ /tests/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^imaging/study\.html$ /imaging/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^procedures/procedure\.html$ /procedures/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^medications/medication\.html$ /medications/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^drug\-classes/class\.html$ /drug-classes/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^first\-aid/topic\.html$ /first-aid/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^health/topic\.html$ /health/%1/? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^organs/organ\.html$ /anatomy/%1/? [R=301,L]
  # /section/index.html -> /section/ and /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
  # retired paths
  RewriteRule ^learn/terminology\.html$ /medical-terms/ [R=301,L]
  RewriteRule ^learn/?$ /medical-terms/ [R=301,L]
  # URL aliases (synonyms, abbreviations, brand names, old ids) -> the canonical page, in one hop
  RewriteRule ^anatomy/(adrenal\-gland|adrenal\-glands)/?$ /anatomy/adrenals/ [R=301,L]
  RewriteRule ^organs/(adrenal\-gland|adrenal\-glands)/?$ /anatomy/adrenals/ [R=301,L]
  RewriteRule ^anatomy/(aortic)/?$ /anatomy/aorta/ [R=301,L]
  RewriteRule ^organs/(aortic)/?$ /anatomy/aorta/ [R=301,L]
  RewriteRule ^anatomy/(urethra|urinary\-bladder)/?$ /anatomy/bladder/ [R=301,L]
  RewriteRule ^organs/(urethra|urinary\-bladder)/?$ /anatomy/bladder/ [R=301,L]
  RewriteRule ^anatomy/(cerebrum|human\-brain)/?$ /anatomy/brain/ [R=301,L]
  RewriteRule ^organs/(cerebrum|human\-brain)/?$ /anatomy/brain/ [R=301,L]
  RewriteRule ^anatomy/(coronary\-arteries|coronary\-artery)/?$ /anatomy/coronary/ [R=301,L]
  RewriteRule ^organs/(coronary\-arteries|coronary\-artery)/?$ /anatomy/coronary/ [R=301,L]
  RewriteRule ^anatomy/(ankle|tarsal\-bones)/?$ /anatomy/foot/ [R=301,L]
  RewriteRule ^organs/(ankle|tarsal\-bones)/?$ /anatomy/foot/ [R=301,L]
  RewriteRule ^anatomy/(bile\-ducts|gall\-bladder)/?$ /anatomy/gallbladder/ [R=301,L]
  RewriteRule ^organs/(bile\-ducts|gall\-bladder)/?$ /anatomy/gallbladder/ [R=301,L]
  RewriteRule ^anatomy/(carpal\-bones|wrist)/?$ /anatomy/hand/ [R=301,L]
  RewriteRule ^organs/(carpal\-bones|wrist)/?$ /anatomy/hand/ [R=301,L]
  RewriteRule ^anatomy/(cardiac|human\-heart)/?$ /anatomy/heart/ [R=301,L]
  RewriteRule ^organs/(cardiac|human\-heart)/?$ /anatomy/heart/ [R=301,L]
  RewriteRule ^anatomy/(kidney|renal)/?$ /anatomy/kidneys/ [R=301,L]
  RewriteRule ^organs/(kidney|renal)/?$ /anatomy/kidneys/ [R=301,L]
  RewriteRule ^anatomy/(knee\-joint)/?$ /anatomy/knee/ [R=301,L]
  RewriteRule ^organs/(knee\-joint)/?$ /anatomy/knee/ [R=301,L]
  RewriteRule ^anatomy/(bowel|colon|large\-bowel)/?$ /anatomy/large-intestine/ [R=301,L]
  RewriteRule ^organs/(bowel|colon|large\-bowel)/?$ /anatomy/large-intestine/ [R=301,L]
  RewriteRule ^anatomy/(hepatic)/?$ /anatomy/liver/ [R=301,L]
  RewriteRule ^organs/(hepatic)/?$ /anatomy/liver/ [R=301,L]
  RewriteRule ^anatomy/(lung|lung\-anatomy)/?$ /anatomy/lungs/ [R=301,L]
  RewriteRule ^organs/(lung|lung\-anatomy)/?$ /anatomy/lungs/ [R=301,L]
  RewriteRule ^anatomy/(esophagus|gullet)/?$ /anatomy/oesophagus/ [R=301,L]
  RewriteRule ^organs/(esophagus|gullet)/?$ /anatomy/oesophagus/ [R=301,L]
  RewriteRule ^anatomy/(hip|pelvis)/?$ /anatomy/pelvic-girdle/ [R=301,L]
  RewriteRule ^organs/(hip|pelvis)/?$ /anatomy/pelvic-girdle/ [R=301,L]
  RewriteRule ^anatomy/(hypophysis|pituitary\-gland)/?$ /anatomy/pituitary/ [R=301,L]
  RewriteRule ^organs/(hypophysis|pituitary\-gland)/?$ /anatomy/pituitary/ [R=301,L]
  RewriteRule ^anatomy/(ribs|sternum)/?$ /anatomy/rib-cage/ [R=301,L]
  RewriteRule ^organs/(ribs|sternum)/?$ /anatomy/rib-cage/ [R=301,L]
  RewriteRule ^anatomy/(clavicle|scapula|shoulder)/?$ /anatomy/shoulder-girdle/ [R=301,L]
  RewriteRule ^organs/(clavicle|scapula|shoulder)/?$ /anatomy/shoulder-girdle/ [R=301,L]
  RewriteRule ^anatomy/(cranium)/?$ /anatomy/skull/ [R=301,L]
  RewriteRule ^organs/(cranium)/?$ /anatomy/skull/ [R=301,L]
  RewriteRule ^anatomy/(intestine|small\-bowel)/?$ /anatomy/small-intestine/ [R=301,L]
  RewriteRule ^organs/(intestine|small\-bowel)/?$ /anatomy/small-intestine/ [R=301,L]
  RewriteRule ^anatomy/(backbone|spinal\-column|vertebral\-column)/?$ /anatomy/spine/ [R=301,L]
  RewriteRule ^organs/(backbone|spinal\-column|vertebral\-column)/?$ /anatomy/spine/ [R=301,L]
  RewriteRule ^anatomy/(gastric)/?$ /anatomy/stomach/ [R=301,L]
  RewriteRule ^organs/(gastric)/?$ /anatomy/stomach/ [R=301,L]
  RewriteRule ^anatomy/(testicles|testis)/?$ /anatomy/testes/ [R=301,L]
  RewriteRule ^organs/(testicles|testis)/?$ /anatomy/testes/ [R=301,L]
  RewriteRule ^anatomy/(airways|bronchi|trachea)/?$ /anatomy/trachea-bronchi/ [R=301,L]
  RewriteRule ^organs/(airways|bronchi|trachea)/?$ /anatomy/trachea-bronchi/ [R=301,L]
  RewriteRule ^physiology/(how\-blood\-pressure\-works)/?$ /physiology/blood-pressure/ [R=301,L]
  RewriteRule ^physiology/(heartbeat)/?$ /physiology/cardiac-cycle/ [R=301,L]
  RewriteRule ^physiology/(kidney\-filtration|renal\-filtration)/?$ /physiology/filtration/ [R=301,L]
  RewriteRule ^physiology/(respiration)/?$ /physiology/gas-exchange/ [R=301,L]
  RewriteRule ^physiology/(liver\-function)/?$ /physiology/liver-functions/ [R=301,L]
  RewriteRule ^physiology/(action\-potential|nerve\-impulse)/?$ /physiology/nerve-signals/ [R=301,L]
  RewriteRule ^symptoms/(stomach\-pain|tummy\-pain)/?$ /symptoms/abdominal-pain/ [R=301,L]
  RewriteRule ^symptoms/(chest\-tightness)/?$ /symptoms/chest-pain/ [R=301,L]
  RewriteRule ^symptoms/(lightheadedness|vertigo)/?$ /symptoms/dizziness/ [R=301,L]
  RewriteRule ^symptoms/(tiredness)/?$ /symptoms/fatigue/ [R=301,L]
  RewriteRule ^symptoms/(headaches)/?$ /symptoms/headache/ [R=301,L]
  RewriteRule ^symptoms/(skin\-rash)/?$ /symptoms/rash/ [R=301,L]
  RewriteRule ^symptoms/(breathlessness|dyspnea|dyspnoea)/?$ /symptoms/shortness-of-breath/ [R=301,L]
  RewriteRule ^symptoms/(edema|oedema)/?$ /symptoms/swelling/ [R=301,L]
  RewriteRule ^symptoms/(paraesthesia|pins\-and\-needles)/?$ /symptoms/tingling/ [R=301,L]
  RewriteRule ^conditions/(acl\-tear|anterior\-cruciate\-ligament\-injury)/?$ /conditions/acl-injury/ [R=301,L]
  RewriteRule ^conditions/(alzheimers|dementia)/?$ /conditions/alzheimers-disease/ [R=301,L]
  RewriteRule ^conditions/(anemia)/?$ /conditions/anaemia/ [R=301,L]
  RewriteRule ^conditions/(af|afib)/?$ /conditions/atrial-fibrillation/ [R=301,L]
  RewriteRule ^conditions/(ckd|kidney\-failure)/?$ /conditions/chronic-kidney-disease/ [R=301,L]
  RewriteRule ^conditions/(chronic\-obstructive\-pulmonary\-disease|emphysema)/?$ /conditions/copd/ [R=301,L]
  RewriteRule ^conditions/(angina|coronary\-heart\-disease|ischaemic\-heart\-disease)/?$ /conditions/coronary-artery-disease/ [R=301,L]
  RewriteRule ^conditions/(dvt)/?$ /conditions/deep-vein-thrombosis/ [R=301,L]
  RewriteRule ^conditions/(acid\-reflux|gord|reflux)/?$ /conditions/gerd/ [R=301,L]
  RewriteRule ^conditions/(high\-blood\-pressure)/?$ /conditions/hypertension/ [R=301,L]
  RewriteRule ^conditions/(crohns\-disease|ibd|ulcerative\-colitis)/?$ /conditions/inflammatory-bowel-disease/ [R=301,L]
  RewriteRule ^conditions/(heart\-attack|mi)/?$ /conditions/myocardial-infarction/ [R=301,L]
  RewriteRule ^conditions/(arthritis)/?$ /conditions/osteoarthritis/ [R=301,L]
  RewriteRule ^conditions/(parkinsons)/?$ /conditions/parkinsons-disease/ [R=301,L]
  RewriteRule ^conditions/(lung\-clot|pe)/?$ /conditions/pulmonary-embolism/ [R=301,L]
  RewriteRule ^conditions/(cva|tia)/?$ /conditions/stroke/ [R=301,L]
  RewriteRule ^conditions/(type\-1\-diabetes\-mellitus)/?$ /conditions/type-1-diabetes/ [R=301,L]
  RewriteRule ^conditions/(diabetes|type\-2\-diabetes\-mellitus)/?$ /conditions/type-2-diabetes/ [R=301,L]
  RewriteRule ^conditions/(cystitis|uti)/?$ /conditions/urinary-tract-infection/ [R=301,L]
  RewriteRule ^tests/(bnp|troponin)/?$ /tests/cardiac-biomarkers/ [R=301,L]
  RewriteRule ^tests/(cbc|fbc|full\-blood\-count)/?$ /tests/complete-blood-count/ [R=301,L]
  RewriteRule ^tests/(ekg|electrocardiogram)/?$ /tests/ecg/ [R=301,L]
  RewriteRule ^tests/(echo)/?$ /tests/echocardiogram/ [R=301,L]
  RewriteRule ^tests/(glycated\-haemoglobin)/?$ /tests/hba1c/ [R=301,L]
  RewriteRule ^tests/(crp|esr)/?$ /tests/inflammatory-markers/ [R=301,L]
  RewriteRule ^tests/(creatinine|egfr|u\-and\-e)/?$ /tests/kidney-function-tests/ [R=301,L]
  RewriteRule ^tests/(lfts)/?$ /tests/liver-function-tests/ [R=301,L]
  RewriteRule ^tests/(tfts|tsh)/?$ /tests/thyroid-function-tests/ [R=301,L]
  RewriteRule ^imaging/(cat\-scan|ct)/?$ /imaging/ct-scan/ [R=301,L]
  RewriteRule ^imaging/(mammogram)/?$ /imaging/mammography/ [R=301,L]
  RewriteRule ^imaging/(mri\-scan)/?$ /imaging/mri/ [R=301,L]
  RewriteRule ^imaging/(pet|pet\-ct)/?$ /imaging/pet-scan/ [R=301,L]
  RewriteRule ^imaging/(sonography|ultrasound\-scan)/?$ /imaging/ultrasound/ [R=301,L]
  RewriteRule ^imaging/(radiograph|xray)/?$ /imaging/x-ray/ [R=301,L]
  RewriteRule ^procedures/(pci|stent)/?$ /procedures/angioplasty/ [R=301,L]
  RewriteRule ^procedures/(appendicectomy)/?$ /procedures/appendectomy/ [R=301,L]
  RewriteRule ^procedures/(angiogram|cardiac\-catheterisation|coronary\-angiogram)/?$ /procedures/cardiac-catheterization/ [R=301,L]
  RewriteRule ^procedures/(gallbladder\-removal)/?$ /procedures/cholecystectomy/ [R=301,L]
  RewriteRule ^procedures/(bypass\-surgery|cabg|heart\-bypass)/?$ /procedures/coronary-bypass/ [R=301,L]
  RewriteRule ^procedures/(haemodialysis|hemodialysis)/?$ /procedures/dialysis/ [R=301,L]
  RewriteRule ^procedures/(arthrocentesis|steroid\-injection)/?$ /procedures/joint-aspiration/ [R=301,L]
  RewriteRule ^procedures/(knee\-arthroplasty|total\-knee\-replacement)/?$ /procedures/knee-replacement/ [R=301,L]
  RewriteRule ^procedures/(endoscopy|gastroscopy)/?$ /procedures/upper-endoscopy/ [R=301,L]
  RewriteRule ^procedures/(catheter|urinary\-catheter)/?$ /procedures/urinary-catheterization/ [R=301,L]
  RewriteRule ^medications/(alendronic\-acid|fosamax)/?$ /medications/alendronate/ [R=301,L]
  RewriteRule ^medications/(zyloric)/?$ /medications/allopurinol/ [R=301,L]
  RewriteRule ^medications/(norvasc)/?$ /medications/amlodipine/ [R=301,L]
  RewriteRule ^medications/(eliquis)/?$ /medications/apixaban/ [R=301,L]
  RewriteRule ^medications/(lipitor)/?$ /medications/atorvastatin/ [R=301,L]
  RewriteRule ^medications/(zyrtec)/?$ /medications/cetirizine/ [R=301,L]
  RewriteRule ^medications/(frusemide|lasix)/?$ /medications/furosemide/ [R=301,L]
  RewriteRule ^medications/(gtn|nitroglycerin)/?$ /medications/glyceryl-trinitrate/ [R=301,L]
  RewriteRule ^medications/(advil|nurofen)/?$ /medications/ibuprofen/ [R=301,L]
  RewriteRule ^medications/(synthroid|thyroxine)/?$ /medications/levothyroxine/ [R=301,L]
  RewriteRule ^medications/(cozaar)/?$ /medications/losartan/ [R=301,L]
  RewriteRule ^medications/(glucophage)/?$ /medications/metformin/ [R=301,L]
  RewriteRule ^medications/(beta\-blocker)/?$ /medications/metoprolol/ [R=301,L]
  RewriteRule ^medications/(losec|prilosec)/?$ /medications/omeprazole/ [R=301,L]
  RewriteRule ^medications/(acetaminophen|panadol|tylenol)/?$ /medications/paracetamol/ [R=301,L]
  RewriteRule ^medications/(ace\-inhibitor)/?$ /medications/ramipril/ [R=301,L]
  RewriteRule ^medications/(albuterol|ventolin)/?$ /medications/salbutamol/ [R=301,L]
  RewriteRule ^medications/(zoloft)/?$ /medications/sertraline/ [R=301,L]
  RewriteRule ^medications/(coumadin)/?$ /medications/warfarin/ [R=301,L]
  RewriteRule ^drug-classes/(ace\-inhibitor|acei|angiotensin\-converting\-enzyme\-inhibitors)/?$ /drug-classes/ace-inhibitors/ [R=301,L]
  RewriteRule ^drug-classes/(arb|arbs|sartans)/?$ /drug-classes/angiotensin-receptor-blockers/ [R=301,L]
  RewriteRule ^drug-classes/(blood\-thinners|doacs)/?$ /drug-classes/anticoagulants/ [R=301,L]
  RewriteRule ^drug-classes/(h1\-antihistamines)/?$ /drug-classes/antihistamines/ [R=301,L]
  RewriteRule ^drug-classes/(antiplatelet\-drugs)/?$ /drug-classes/antiplatelets/ [R=301,L]
  RewriteRule ^drug-classes/(beta\-adrenoceptor\-blockers|betablockers)/?$ /drug-classes/beta-blockers/ [R=301,L]
  RewriteRule ^drug-classes/(biguanide)/?$ /drug-classes/biguanides/ [R=301,L]
  RewriteRule ^drug-classes/(bisphosphonate)/?$ /drug-classes/bisphosphonates/ [R=301,L]
  RewriteRule ^drug-classes/(relievers)/?$ /drug-classes/bronchodilators/ [R=301,L]
  RewriteRule ^drug-classes/(calcium\-antagonists|ccbs)/?$ /drug-classes/calcium-channel-blockers/ [R=301,L]
  RewriteRule ^drug-classes/(glucocorticoids|steroids)/?$ /drug-classes/corticosteroids/ [R=301,L]
  RewriteRule ^drug-classes/(insulin\-therapy)/?$ /drug-classes/insulins/ [R=301,L]
  RewriteRule ^drug-classes/(water\-tablets)/?$ /drug-classes/loop-diuretics/ [R=301,L]
  RewriteRule ^drug-classes/(organic\-nitrates)/?$ /drug-classes/nitrates/ [R=301,L]
  RewriteRule ^drug-classes/(simple\-analgesics)/?$ /drug-classes/non-opioid-analgesics/ [R=301,L]
  RewriteRule ^drug-classes/(non\-steroidal\-anti\-inflammatory\-drugs|nsaid)/?$ /drug-classes/nsaids/ [R=301,L]
  RewriteRule ^drug-classes/(opiates|opioid\-analgesics)/?$ /drug-classes/opioids/ [R=301,L]
  RewriteRule ^drug-classes/(penicillin\-antibiotics)/?$ /drug-classes/penicillins/ [R=301,L]
  RewriteRule ^drug-classes/(ppi|ppis)/?$ /drug-classes/proton-pump-inhibitors/ [R=301,L]
  RewriteRule ^drug-classes/(selective\-serotonin\-reuptake\-inhibitors|ssri)/?$ /drug-classes/ssris/ [R=301,L]
  RewriteRule ^drug-classes/(hmg\-coa\-reductase\-inhibitors)/?$ /drug-classes/statins/ [R=301,L]
  RewriteRule ^drug-classes/(thyroid\-hormone\-replacement)/?$ /drug-classes/thyroid-hormones/ [R=301,L]
  RewriteRule ^drug-classes/(urate\-lowering\-drugs)/?$ /drug-classes/xanthine-oxidase-inhibitors/ [R=301,L]
  RewriteRule ^first-aid/(anaphylaxis)/?$ /first-aid/allergic-reactions/ [R=301,L]
  RewriteRule ^first-aid/(scalds)/?$ /first-aid/burns/ [R=301,L]
  RewriteRule ^first-aid/(aed|cardiopulmonary\-resuscitation|defibrillator)/?$ /first-aid/cpr/ [R=301,L]
  RewriteRule ^first-aid/(recovery\-position|syncope)/?$ /first-aid/fainting/ [R=301,L]
  RewriteRule ^first-aid/(broken\-bone|broken\-bones)/?$ /first-aid/fractures/ [R=301,L]
  RewriteRule ^first-aid/(heat\-exhaustion)/?$ /first-aid/heatstroke/ [R=301,L]
  RewriteRule ^first-aid/(fits|seizure)/?$ /first-aid/seizures/ [R=301,L]
  RewriteRule ^first-aid/(bleeding|haemorrhage)/?$ /first-aid/severe-bleeding/ [R=301,L]
  RewriteRule ^health/(physical\-activity)/?$ /health/exercise/ [R=301,L]
  RewriteRule ^health/(dehydration|water)/?$ /health/hydration/ [R=301,L]
  RewriteRule ^health/(diet|healthy\-eating)/?$ /health/nutrition/ [R=301,L]
  RewriteRule ^health/(quit\-smoking|vaping)/?$ /health/smoking/ [R=301,L]
  RewriteRule ^health/(bmi|obesity)/?$ /health/weight/ [R=301,L]
  # organ pages moved to /anatomy/
  RewriteRule ^organs/([A-Za-z0-9-]+)/?$ /anatomy/$1/ [R=301,L]
  # trailing slash on every section page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(anatomy|systems|physiology|symptoms|conditions|tests|imaging|procedures|medications|drug-classes|first-aid|health)/([A-Za-z0-9-]+)$ /$1/$2/ [R=301,L]

  # ---- clean-URL fallback: /conditions/gout/ -> conditions/condition.html?id=gout when no prerendered page exists
  # Only for paths that are not real files or directories and only for slug-shaped segments, so index.html, the
  # section scripts and every asset are served directly. A prerendered site never reaches these rules.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^anatomy/([A-Za-z0-9-]+)/?$ anatomy/organ.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^systems/([A-Za-z0-9-]+)/?$ systems/system.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^physiology/([A-Za-z0-9-]+)/?$ physiology/topic.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^symptoms/([A-Za-z0-9-]+)/?$ symptoms/symptom.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^conditions/([A-Za-z0-9-]+)/?$ conditions/condition.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^tests/([A-Za-z0-9-]+)/?$ tests/test.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^imaging/([A-Za-z0-9-]+)/?$ imaging/study.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^procedures/([A-Za-z0-9-]+)/?$ procedures/procedure.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^medications/([A-Za-z0-9-]+)/?$ medications/medication.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^drug-classes/([A-Za-z0-9-]+)/?$ drug-classes/class.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^first-aid/([A-Za-z0-9-]+)/?$ first-aid/topic.html?id=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^health/([A-Za-z0-9-]+)/?$ health/topic.html?id=$1 [L,QSA]
</IfModule>

# ---- custom error page (a real 404 status, never a 200 "not found" page)
ErrorDocument 404 /404.html

# ---- correct media types (the explorer checks the glTF magic bytes but browsers still prefer the right type)
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType application/json .json
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddType application/wasm .wasm
  AddType application/xml .xml
  AddCharset utf-8 .html .css .js .mjs .json .svg .md .txt .webmanifest .xml
</IfModule>

# ---- compression (JSON and JS shrink 4-6x; GLB is already meshopt-compressed but still gains ~10%)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/markdown application/javascript application/json application/manifest+json image/svg+xml model/gltf-binary application/xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/markdown application/javascript application/json application/manifest+json image/svg+xml model/gltf-binary application/xml
</IfModule>

# ---- caching: fingerprint-free but versioned by deploy; geometry, previews and vendor code change rarely
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(glb|jpg|png)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.xml$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # ---- security headers (the pages also carry a meta CSP; frame-ancestors can only be set here)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-0ZYYoMVH8skVI3zJ7AfEL0FDpRE4dS3zbGhdQKihick='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header unset X-Powered-By
</IfModule>

# ---- never serve repository housekeeping
<FilesMatch "^(\.git.*|\.env.*|\.htpasswd|package(-lock)?\.json|.*\.py|.*\.yml|.*\.yaml)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
